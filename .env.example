# =====================================================
# Family Wallet — приклад змінних середовища.
# Скопіюйте у .env та заповніть. НІКОЛИ не комітьте .env!
# =====================================================

# --- MongoDB Atlas (backend) -------------------------
MONGO_ATLAS=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=YourCluster
DB_NAME=FamilyWallet

# --- JWT (backend) -----------------------------------
# Згенеруй: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Monobank інтеграція (backend) -------------------
# AES-256 ключ у base64 (32 байти).
# Згенеруй: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MONOBANK_ENCRYPTION_KEY=
# Публічний https URL бекенду, на який Монобанк надсилатиме webhook'и
# Прод: https://family-wallet-backend-tb1v.onrender.com/api/v1/monobank/webhook
MONOBANK_WEBHOOK_URL=

# --- CORS (backend) ----------------------------------
# Перелік дозволених origins фронтенду через кому.
# Прод: https://family-wallet.pages.dev
CORS_ORIGINS=https://family-wallet.pages.dev,http://localhost:5173
# (опціонально) regex для preview-доменів Cloudflare Pages
# CORS_ORIGIN_REGEX=^https://.*\\.family-wallet\\.pages\\.dev$

# --- Runtime mode (backend) --------------------------
# 'production' активує fail-fast перевірку JWT_SECRET
ENV=development

# --- Frontend (Vite) ---------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws/feed
VITE_WS_ENABLED=true
VITE_REALTIME_MODE=off
